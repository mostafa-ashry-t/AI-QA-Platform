<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>qa.orangehrm</groupId>
    <artifactId>orangehrm-directory-shaft</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>OrangeHRM Directory - TC-054 (SHAFT Engine)</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <shaft.version>10.1.20260123</shaft.version>
        <aspectj.version>1.9.25.1</aspectj.version>
        <surefire.version>3.5.4</surefire.version>
        <!-- Optional extra JVM arguments for the test JVM (empty by default). On Windows
             profiles whose path contains a space, pass -Dshaft.extraArgLine=-Duser.home=<8.3 short path>:
             SHAFT 10.1 runs its Allure CLI from user.home without quoting (run B2; healing H-003). -->
        <shaft.extraArgLine></shaft.extraArgLine>
    </properties>

    <dependencies>
        <!-- Brings Selenium WebDriver 4.40.0, TestNG 7.12.0 and Allure. -->
        <dependency>
            <groupId>io.github.shafthq</groupId>
            <artifactId>SHAFT_ENGINE</artifactId>
            <version>${shaft.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- Never rerun a failed test: a rerun could hide a real failure. -->
                    <rerunFailingTestsCount>0</rerunFailingTestsCount>
                    <!-- SHAFT's TestNG listener reads rp.enable before its defaults are loaded
                         (NPE in run B1; healing H-002). ReportPortal is not used. -->
                    <systemPropertyVariables>
                        <rp.enable>false</rp.enable>
                    </systemPropertyVariables>
                    <argLine>-javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar" ${shaft.extraArgLine}</argLine>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>${surefire.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
